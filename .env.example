# Copy to .env (or run `python scripts/init_env.py`, which fills in random values).
# Never commit .env. Every value here is a placeholder.

# Postgres superuser password. Used only by scripts/db_bootstrap.py to create roles.
POSTGRES_PASSWORD=change-me

# Database roles created by scripts/db_bootstrap.py
PIQ_DB_HOST=127.0.0.1
PIQ_DB_PORT=5432
PIQ_DB_NAME=propertyiq_db
# piq_owner owns the schema (migrations and seeding only); piq_readonly is SELECT-only and used by the API
PIQ_OWNER_PASSWORD=change-me
PIQ_READONLY_PASSWORD=change-me

# Demo sign-in (synthetic data only; not production authentication)
PIQ_SESSION_SECRET=change-me
PIQ_DEMO_PASSWORD=change-me

# Local inference. Must be a loopback or private address.
PIQ_OLLAMA_URL=http://127.0.0.1:11434
PIQ_CHAT_MODEL=qwen3:4b-instruct-2507-q4_K_M
PIQ_EMBED_MODEL=nomic-embed-text
PIQ_ALLOWED_MODELS=qwen3:4b-instruct-2507-q4_K_M,qwen3:4b,qwen3:8b,nomic-embed-text
